# ================= Python 缓存、字节码 =================
__pycache__/
*.py[cod]
*$py.class
*.so

# ================= 虚拟环境（conda/venv）=================
venv/
env/
.venv/
*.conda

# ================= 环境密钥！！重要，防止泄露API_KEY =================
.env
.env.local
*.secret

# ================= 日志、输出缓存 =================
*.log
output/
temp/
tmp/

# ================= Mac系统垃圾文件 =================
.DS_Store
.AppleDouble

# ================= PyCharm IDE配置（不要上传IDE本地配置） =================
.idea/
*.iml
*.iws
out/

# ================= 打包构建产物 =================
build/
dist/
*.egg-info/

# ================= 大模型项目：本地向量库、本地缓存 =================
chroma_db/
faiss_index/
*.bin
*.onnx
